# Digital Hub configuration. Copy to `.env` in the repository root and fill it in:
#
#   cp .env.example .env
#
# `.env` is read by Django (python-dotenv) and by Docker Compose, and is never
# committed or copied into the image. Every variable the code reads is listed
# here; commented-out lines show the default used when the variable is unset.
#
# Wrap a value in single quotes if it contains `$` (Docker Compose would
# otherwise try to expand it), e.g. SECRET_KEY='abc$def'.

# --- Django ------------------------------------------------------------------
# Required when DEBUG=False: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True only on a developer machine.
DEBUG=False
ALLOWED_HOSTS=data-hub.mopd.gov.et,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://data-hub.mopd.gov.et
CORS_ALLOWED_ORIGINS=https://data-hub.mopd.gov.et
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOW_CREDENTIALS=True

# --- Database ----------------------------------------------------------------
# USE_SQLITE defaults to DEBUG; SQLite lives in core/db.sqlite3. In Docker the
# local stack (compose.yaml) always uses its own PostgreSQL container.
USE_SQLITE=False
DATABASE_NAME=digital_hub
DATABASE_USER=digital_hub
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# --- Redis (WebSocket channel layer, Celery) ----------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# USE_REDIS_CHANNELS defaults to (not DEBUG).
# CELERY_BROKER_URL=redis://<REDIS_HOST>:<REDIS_PORT>/0
# CELERY_RESULT_BACKEND=redis://<REDIS_HOST>:<REDIS_PORT>/1

# --- Email (sign-in codes, password reset) --------------------------------------
EMAIL=noreply@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- DPMES (ministry and policy-area performance) -----------------------------
# The key is issued in the DPMES Django admin and shown once. API docs:
# https://dpmes.mopd.gov.et/api/docs/
DPMES2_API_BASE=https://dpmes.mopd.gov.et
DPMES2_API_KEY=

# --- Admas AI (docs/ai.md) -----------------------------------------------------
# Chat and embeddings come from the Ministry LLM gateway (OpenAI-compatible).
# Full endpoint URLs are accepted; /chat/completions and /embeddings are stripped.
VLLM_API_BASE=https://llm.mopd.gov.et/v1
VLLM_MODEL=gemma-4-31b
VLLM_API_KEY=
EMBEDDING_API_BASE=https://llm.mopd.gov.et/v1
# Changing the model re-embeds the whole catalog on the next `manage.py sync_ai_catalog`.
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
# The time-series service: the AI and the /api/mobile/ data endpoints both use this address.
TIME_SERIES_API_BASE=https://time-series.mopd.gov.et/api/mobile
# The national SDG platform (SDG pages and the AI). Optional; this is the default.
# SDG_PLATFORM_BASE=https://sdg.mopd.gov.et
# Web search for general questions, through the private SearXNG service. Both
# compose files set SEARXNG_URL; leave it empty to turn web search off.
# SEARXNG_URL=http://searxng:8080
# WEB_SEARCH_ENABLED=True
# Web-searched answers per user per day (0 = no limit).
# WEB_SEARCH_DAILY_LIMIT=50
# AI_REQUEST_TIMEOUT=60
# AI_MAX_RETRIES=3
# AI_WS_MAX_CONCURRENCY=20
# Amharic answers may only use Ethiopic, Latin and punctuation (needs vLLM structured outputs).
# AI_AMHARIC_CONSTRAINED=True
# Queue REST answers on Celery instead of answering in the request:
# AI_USE_ASYNC_QUEUE=False

# --- Push notifications (Firebase) ---------------------------------------------
# The service-account key file is never committed. Default location (git-ignored):
#   secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS=secrets/firebase-service-account.json

# --- Security headers (defaults follow DEBUG) ---------------------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SECURE_REFERRER_POLICY=same-origin
# X_FRAME_OPTIONS=DENY
