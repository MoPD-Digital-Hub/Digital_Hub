SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=api.example.com,www.example.com

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://app.example.com

# Database
USE_SQLITE=False
DATABASE_NAME=digital_hub
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Email
EMAIL=YOUR_EMAIL
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=YOUR_SMTP_USERNAME
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY

# Channels / Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# OIDC
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
OIDC_OP_LOGOUT_ENDPOINT=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_RP_SIGN_ALGO=RS256
OIDC_STORE_ID_TOKEN=True
OIDC_CREATE_USER=False

# AI configuration
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_HISTORY_TURNS=4
GEMINI_STREAM_CHUNK_CHARS=180
MAX_HISTORY_QUESTIONS=4
DASHBOARD_CREATE_API_URL=https://analytics.mopd.gov.et/api/ai-dashboard-create/
DASHBOARD_TIMEOUT_SECONDS=30
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION_NAME=admas_data
MILVUS_RETRIEVAL_K=5
MILVUS_RETRIEVAL_FETCH_K=12
MILVUS_TIMEOUT_SECONDS=30
TIME_SERIES_API_BASE=https://time-series.mopd.gov.et/api/mobile
TIME_SERIES_INDICATOR_LIMIT=1
DPMES_API_BASE=https://dpmes.mopd.gov.et
PUBLIC_BODY_SCORE_LIMIT=1
EMBEDDING_API_BASE=http://localhost:4001/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_API_KEY=empty
AI_WS_MAX_CONCURRENCY=20
